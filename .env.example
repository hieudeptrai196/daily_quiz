# Token bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Chuỗi bí mật để Telegram gửi kèm webhook, chỉ gồm A-Z a-z 0-9 _ - (tự nghĩ, dài 32+ ký tự)
TELEGRAM_WEBHOOK_SECRET=

# ID của group, dạng -100xxxxxxxxxx (gõ /chatid trong group để lấy). Lúc đầu có thể để trống.
TELEGRAM_CHAT_ID=

# 4 người chơi, định dạng userId:Tên cách nhau dấu phẩy (gõ /myid để lấy userId). Lúc đầu có thể để trống.
MEMBERS=111111111:Hiếu,222222222:An,333333333:Bình,444444444:Chi

# Các userId được dùng /reveal, cách nhau dấu phẩy
ADMIN_IDS=111111111

# Nhà cung cấp LLM: groq hoặc gemini (bỏ trống: dùng groq nếu có GROQ_API_KEY)
LLM_PROVIDER=groq

# API key Groq (free), lấy tại https://console.groq.com/keys
# Có thể điền nhiều key cách nhau dấu phẩy để xoay vòng. Quota tính theo TÀI KHOẢN Groq,
# nên các key phải thuộc các tài khoản khác nhau mới tăng được quota.
GROQ_API_KEY=

# Model Groq, cần hỗ trợ structured outputs strict
GROQ_MODEL=openai/gpt-oss-120b

# Model dự phòng khi model chính hết quota (mỗi model có quota riêng); "none" để tắt
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# API key Gemini, lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini; nên dùng alias để không bị khai tử
GEMINI_MODEL=gemini-flash-latest

# Độ khó mô tả cho Gemini
QUIZ_DIFFICULTY=khó, dành cho developer đã đi làm 3-5 năm; cần suy luận nhiều bước, đáp án sai là bẫy hợp lý

# Vercel tự gửi header "Authorization: Bearer <CRON_SECRET>" khi gọi cron (tự nghĩ, dài 32+ ký tự)
CRON_SECRET=

# Upstash Redis. Nếu tạo qua Vercel Marketplace thì Vercel tự thêm KV_REST_API_URL / KV_REST_API_TOKEN, không cần điền 2 biến này.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL public của app trên Vercel, chỉ dùng cho `npm run set-webhook` chạy ở local
PUBLIC_URL=https://ten-app.vercel.app
